
ARG_WITH("pango", "Pango Library Bindings", "no");

if (PHP_PANGO != "no") {
    // STDOUT.WriteLine("PHP_PANGO is set to " + PHP_PANGO);
    // STDOUT.WriteLine("PHP_PHP_BUILD is set to " + PHP_PHP_BUILD);
    // STDOUT.WriteLine("PHP_PREFIX is set to " + PHP_PREFIX);
    if (CHECK_HEADER_ADD_INCLUDE("pango/pango.h", "CFLAGS_PANGO", PHP_PANGO + "\\include\\pango-1.0;" + PHP_PHP_BUILD + "\\include\\pango-1.0")
        && CHECK_HEADER_ADD_INCLUDE("glib.h", "CFLAGS_PANGO", PHP_PANGO + "\\include\\glib-2.0;" + PHP_PHP_BUILD + "\\include\\glib-2.0")
        && CHECK_HEADER_ADD_INCLUDE("glib-object.h", "CFLAGS_PANGO", PHP_PANGO + "\\include\\glib-2.0;" + PHP_PHP_BUILD + "\\include\\glib-2.0")
        && CHECK_HEADER_ADD_INCLUDE("glibconfig.h", "CFLAGS_PANGO", PHP_PANGO + "\\lib\\glib-2.0\\include;" + PHP_PHP_BUILD + "\\lib\\glib-2.0\\include")

        && CHECK_HEADER_ADD_INCLUDE("hb.h", "CFLAGS_PANGO", PHP_PANGO + "\\include\\harfbuzz;" + PHP_PHP_BUILD + "\\include\\harfbuzz")
        && CHECK_HEADER_ADD_INCLUDE("fontconfig\\fontconfig.h", "CFLAGS_PANGO", PHP_PANGO + "\\include;" + PHP_PHP_BUILD + "\\include")

        && CHECK_HEADER_ADD_INCLUDE("cairo.h", "CFLAGS_PANGO", PHP_PANGO + "\\include\\cairo;" + PHP_PHP_BUILD + "\\include\\cairo")
        && CHECK_HEADER_ADD_INCLUDE("php_cairo_internal.h", "CFLAGS_PANGO", PHP_PANGO + "\\include;" + PHP_PHP_BUILD + "\\include\\cairo\\src;" + configure_module_dirname + "\\..\\extras\\cairo;" + "C:\\tools\\php\\extras\\cairo")

        && CHECK_LIB("pango-1.0.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("pangocairo-1.0.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("pangowin32-1.0.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("pangoft2-1.0.lib", "pango", PHP_PANGO + "\\lib")

        && CHECK_LIB("cairo.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("php_cairo.lib", "pango", PHP_PANGO + "\\lib;C:\\tools\\php\\extras\\cairo")

        && CHECK_LIB("gobject-2.0.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("glib-2.0.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("gio-2.0.lib", "pango", PHP_PANGO + "\\lib")

        && CHECK_LIB("harfbuzz.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("fribidi.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("freetype.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("fontconfig.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("pixman-1.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("libpng16.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("ffi.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("intl.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("pcre2-8.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("charset.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("iconv.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("zlib.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("bz2.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("brotlidec.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("brotlicommon.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("libexpatMD.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("Gdi32.lib", "pango", "")
        && CHECK_LIB("Dwrite.lib", "pango", "")

        // && ADD_EXTENSION_DEP('pango', 'cairo')
    ) {
        ADD_FLAG("CFLAGS_PANGO", "/I " + configure_module_dirname);
        ADD_FLAG("CFLAGS_PANGO", "/I " + configure_module_dirname + "\\src");

        EXTENSION("pango", "src\\pango.c src\\exception.c src\\context.c src\\layout.c src\\font_description.c src\\layout_line.c src\\glyph_item.c src\\item.c src\\glyph_string.c src\\glyph_info.c src\\matrix.c src\\rectangle.c src\\font_map.c src\\pango_cairo_font_map.c src\\font_family.c src\\font_face.c src\\pango_cairo_layout.c src\\pango_cairo_context.c");
        AC_DEFINE("HAVE_PANGO", 1);
        // PHP_INSTALL_HEADERS("ext/pango", "php-pango.h");
    } else {
        WARNING('Could not find all ext-pango dependencies; skipping');
    }
}
