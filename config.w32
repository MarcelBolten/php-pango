
ARG_WITH("pango", "Pango Library Bindings", "no");

if (PHP_PANGO != "no") {
    STDOUT.WriteLine("PHP_PANGO is set to " + PHP_PANGO);
    STDOUT.WriteLine("PHP_PHP_BUILD is set to " + PHP_PHP_BUILD);
    if (CHECK_HEADER_ADD_INCLUDE("pango.h", "CFLAGS_PANGO", PHP_PANGO + ";" + PHP_PHP_BUILD + "\\include\\pango")
        && CHECK_HEADER_ADD_INCLUDE("glib.h", "CFLAGS_PANGO", PHP_PANGO + ";" + PHP_PHP_BUILD + "\\include\\glib-pango")
        && CHECK_HEADER_ADD_INCLUDE("glib-object.h", "CFLAGS_PANGO", PHP_PANGO + ";" + PHP_PHP_BUILD + "\\include\\glib-pango")

        && CHECK_HEADER_ADD_INCLUDE("cairo.h", "CFLAGS_PANGO", PHP_PANGO + ";" + PHP_PHP_BUILD + "\\include\\cairo")
        && CHECK_HEADER_ADD_INCLUDE("php_cairo_internals.h", "CFLAGS_PANGO", PHP_PANGO + ";" + PHP_PHP_BUILD + "\\include\\cairo\\src")

        && CHECK_LIB("pango-1.0.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("pangocairo-1.0.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("cairo.lib", "pango", PHP_PANGO + "\\lib")
        && CHECK_LIB("gobject-2.0.lib", "pango", PHP_PANGO + "\\lib")

        && ADD_EXTENSION_DEP('cairo')
    ) {
        EXTENSION("pango", "src/pango.c src/exception.c src/context.c src/layout.c src/font_description.c src/layout_line.c src/glyph_item.c src/item.c src/glyph_string.c src/glyph_info.c src/matrix.c src/rectangle.c src/font_map.c src/pango_cairo_font_map.c src/font_family.c src/font_face.c src/pango_cairo_layout.c src/pango_cairo_context.c");
        AC_DEFINE("HAVE_PANGO", 1);
        PHP_INSTALL_HEADERS("ext/pango", "php-pango.h");
    } else {
        WARNING('Could not find pango.lib; skipping');
    }
}
