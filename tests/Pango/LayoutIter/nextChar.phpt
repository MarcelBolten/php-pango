}
object(Pango\Context)#%d (0) {
}
object(Pango\Layout)#%d (0) {
}
object(Pango\LayoutIter)#%d (0) {
}
bool(true)
bool(false)
Pango\LayoutIter::nextChar() expects exactly 0 arguments, 1 given
